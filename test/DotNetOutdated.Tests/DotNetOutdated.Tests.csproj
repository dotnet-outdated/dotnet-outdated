<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFrameworks>net8.0;net9.0;net11.0</TargetFrameworks>
    <!-- net8.0 and net9.0 are out of support, but people use this tool to upgrade off them, so keep
         targeting them and silence the SDK's end-of-life warning (NETSDK1138). -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <IsPackable>false</IsPackable>
    <!-- xUnit.net v3 test projects are executables that run on Microsoft.Testing.Platform (MTP). These live
         here rather than in a root Directory.Build.props, which the fixture projects under test-projects/
         would also import. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" Version="22.3.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DotNetOutdated.Core\DotNetOutdated.Core.csproj" />
    <ProjectReference Include="..\..\src\DotNetOutdated\DotNetOutdated.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="TestData\*.*" />
    <EmbeddedResource Include="TestData\*.*" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="SolutionRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)\..\..'))" />
  </ItemGroup>
</Project>
